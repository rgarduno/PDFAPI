# Claves de acceso Bearer separadas por coma (cada clave es un tenant aislado)
PDFENGINE_API_KEYS=local-dev-secret-key-12345

# Orígenes CORS permitidos para Web Studio o clientes autorizados
PDFENGINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Límites de carga y retención de memoria (opcionales con valores seguros por defecto)
# PDFENGINE_MAX_UPLOAD_BYTES=33554432
# PDFENGINE_MAX_SESSIONS=32
# PDFENGINE_MAX_RETAINED_BYTES=268435456
# PDFENGINE_SESSION_TTL_SECONDS=1800
